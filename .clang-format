---
BasedOnStyle: LLVM
Language: Cpp

# ==========================================
# 基础风格配置
# ==========================================
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -2
UseTab: Never
ColumnLimit: 120
PointerAlignment: Right

# --- G.INC.07-CPP: 按照合理的顺序包含头文件 ---
SortIncludes: CaseSensitive
IncludeBlocks: Regroup               # 排序后按类别在块之间加空行
IncludeIsMainRegex: '(_test\.cpp|\.cpp)$'

IncludeCategories:
  - Regex:    '^<[^.]*>$'            # 1. C++ 标准库 (如 <memory>)
    Priority: 1
  - Regex:    '^<.*\.h>$'            # 2. C/OS 系统库 (如 <unistd.h>)
    Priority: 2
  - Regex:    '^"llvm/.*"'           # 3. 外部依赖库: LLVM
    Priority: 3
  - Regex:    '^"mlir/.*"'           # 4. 外部依赖库: MLIR
    Priority: 4
  - Regex:    '^"ascend/.*"'         # 5. 项目特定头文件 (Ascend 项目代码)
    Priority: 5
  - Regex:    '.*'                   # 6. 其他 (兜底)
    Priority: 6

# ==========================================
# 换行与对齐规则
# ==========================================
# --- G.FMT.06-CPP: 换行时将操作符留在行末 ---
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false

# 换行后的缩进或对齐
AlignAfterOpenBracket: Align        # 参数换行时对齐开括号
ContinuationIndentWidth: 4          # 如果无法对齐，则缩进4空格
AlignOperands: Align                # 换行时对齐操作数

# ==========================================
# 大括号与控制流语句
# ==========================================
# --- G.FMT.11-CPP: 选择、循环语句必须使用大括号 ---
InsertBraces: true                  # 自动补全 if/for/while 缺失的大括号 (Clang 15+)

# 左大括号紧跟语句 (Attach 风格)
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true               # 函数定义的大括号换行 (LLVM 常规风格)
  AfterNamespace: false
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# 语句合并与缩写 (配合强制大括号)
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: All

# ==========================================
# 参数与函数调用
# ==========================================
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 1000
AlwaysBreakAfterDefinitionReturnType: None
BinPackArguments: false             # 换行时每行一个参数，利于对齐
BinPackParameters: false            # 换行时每行一个参数
AllowAllParametersOfDeclarationOnNextLine: true

# ==========================================
# 空格与其他
# ==========================================
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: Never
SpacesInCStyleCastParentheses: false
SpacesInContainerLiterals: true
SpacesInParentheses: false
SpacesInSquareBrackets: false
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: true
IndentCaseLabels: true
IndentCaseBlocks: true
LambdaBodyIndentation: Signature
SeparateDefinitionBlocks: Always    # 自动在函数块之间加空行
...
